#!/usr/bin/env bash
# ==============================================================================
# AdFreeTVRemote Pre-Push Security Guard
# Blocks push if sensitive secrets, API keys, or private keys are detected.
# ==============================================================================

echo "🔍 Running pre-push security scan for sensitive data..."

# Determine commits being pushed
z40="0000000000000000000000000000000000000000"
FAILED=0

while read local_ref local_oid remote_ref remote_oid; do
    if [ "$local_oid" = "$z40" ]; then
        # Branch is being deleted, skip
        continue
    fi

    if [ "$remote_oid" = "$z40" ]; then
        # New branch being pushed, check against origin/main or origin/HEAD if available
        RANGE="$local_oid"
    else
        RANGE="$remote_oid..$local_oid"
    fi

    # 1. Check for prohibited sensitive files
    PROHIBITED_FILES=$(git diff --name-only "$RANGE" | grep -E '\.(env|jks|keystore|pem|p12|pfx|key)$|google-services\.json|service-account.*\.json')
    if [ -n "$PROHIBITED_FILES" ]; then
        echo "❌ [SECURITY POLICY VIOLATION] Attempting to push prohibited sensitive files:"
        echo "$PROHIBITED_FILES"
        FAILED=1
    fi

    # 2. Check for private keys
    PRIVATE_KEYS=$(git diff -U0 "$RANGE" | grep -E '^\+[ ]*-----BEGIN (RSA |DSA |EC |OPENSSH |PGP )?PRIVATE KEY-----')
    if [ -n "$PRIVATE_KEYS" ]; then
        echo "❌ [SECURITY POLICY VIOLATION] Detected Private Key in commit diff!"
        FAILED=1
    fi

    # 3. Check for Google API Keys (AIzaSy...)
    GOOGLE_KEYS=$(git diff -U0 "$RANGE" | grep -E '^\+.*AIza[-0-9A-Za-z_]{35}')
    if [ -n "$GOOGLE_KEYS" ]; then
        echo "❌ [SECURITY POLICY VIOLATION] Detected Google API Key in commit diff!"
        FAILED=1
    fi

    # 4. Check for AWS Access Keys
    AWS_KEYS=$(git diff -U0 "$RANGE" | grep -E '^\+.*(AKIA|ABIA|ACCA|ASIA)[0-9A-Z]{16}')
    if [ -n "$AWS_KEYS" ]; then
        echo "❌ [SECURITY POLICY VIOLATION] Detected AWS Access Key in commit diff!"
        FAILED=1
    fi

    # 5. Check for GitHub Tokens
    GITHUB_TOKENS=$(git diff -U0 "$RANGE" | grep -E '^\+.*(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9_]{36,255}')
    if [ -n "$GITHUB_TOKENS" ]; then
        echo "❌ [SECURITY POLICY VIOLATION] Detected GitHub Token in commit diff!"
        FAILED=1
    fi

done

if [ $FAILED -ne 0 ]; then
    echo ""
    echo "🚫 PUSH REJECTED: Sensitive credentials or prohibited files were detected."
    echo "👉 Please remove or redact the sensitive data and amend your commit before pushing."
    exit 1
fi

echo "✅ Pre-push security scan passed. No sensitive secrets detected."
exit 0
