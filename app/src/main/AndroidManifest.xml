<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for device discovery and secure socket transmission -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Tactile haptic feedback on remote key press -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Foreground service for persistent TV connection & widget controls -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application
        android:name=".AdFreeRemoteApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_tv"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_tv"
        android:supportsRtl="true"
        android:theme="@style/Theme.AdFreeTVRemote"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Main TV Remote Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home Screen Remote Widget Provider -->
        <receiver
            android:name=".widget.RemoteWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/remote_widget_info" />
        </receiver>

        <!-- Widget Action Dispatcher Service (Internal Only) -->
        <service
            android:name=".widget.RemoteWidgetActionService"
            android:exported="false" />

        <!-- Foreground Remote Connection Service (Internal Only) -->
        <service
            android:name=".service.TvRemoteService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>

